# Python
.venv/
__pycache__/
*.pyc

# Traccia trace output (regenerated on each run)
traces.jsonl
traces_*.jsonl

# Secrets - never commit a real key.
# The repo SHIPS a .env with keys COMMENTED OUT (so `cat .env` proves $0/no-key and
# there is one true filename - no .env.example). Put your REAL key in it locally; the
# pre-commit hook blocks committing a .env that contains a real (uncommented) key.
# Still ignore machine-local overrides:
.env.local
.env.*.local

# Local logs
*.log

# Internal working files - never publish (planning/research live in the project workspace)
PENDING-NOTE.md
research.md
365-review-coverage.md
video-plan.md
sdk-reference/
VERIFIED-*.md

# Internal session/recording/evidence notes for this build (never publish)
SESSION-*.md
VIDEO-SCRIPT-*.md
EVIDENCE-INDEX.md
evidence-samples/
ARTICLE-DRAFT.md
RECORDING-PLAN.md
recording/
