# Traccia API key (Govern-tier, for runtime policy enforcement + Governance Hub).
#
# Leave commented out to run the three $0 SDK governance beats in LOCAL mode
# (traces write to traces_gov.jsonl; the local Tier-A block, PII redaction, and
# EU AI Act / transparency evidence all work with NO key).
#
# Uncomment and paste your key from app.traccia.ai -> Settings -> API Keys to
# stream the SAME spans to the platform AND enable @govern runtime enforcement
# (Spend Cap / Model Boundary / Loop Cap) in src/govern_platform.py.
#TRACCIA_API_KEY=your_traccia_api_key_here

# Platform endpoint (REQUIRED for @govern enforcement — not just for tracing).
# Without it the SDK logs "Traccia endpoint not found" and SKIPS enforcement (the run
# returns ALLOWED). Leave commented for $0 local mode; uncomment with your key for Phase 2.
#TRACCIA_ENDPOINT=https://api.traccia.ai/v2/traces
